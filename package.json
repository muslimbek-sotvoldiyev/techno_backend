{
  "name": "katyol-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "node --env-file=.env scripts/bootstrap.cjs",
    "test:integration": "node --env-file=.env --test test/integration.cjs",
    "test:browser": "node --env-file=.env --env-file=test/browser.env --test test/integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "js-yaml": ">=5.4.1 <6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
